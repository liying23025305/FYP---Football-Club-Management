<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create News Article</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/news.css" />
</head>
<body>
  <div class="container mt-5">
    <h2>Create News Article</h2>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form action="/admin/news" method="POST" enctype="multipart/form-data" class="mt-4" novalidate>
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" id="title" name="title" maxlength="200" required>
      </div>
      <div class="mb-3">
        <label for="summary" class="form-label">Summary</label>
        <textarea class="form-control" id="summary" name="summary" maxlength="500" rows="2" required></textarea>
      </div>
      <div class="mb-3">
        <label for="content" class="form-label">Content</label>
        <textarea class="form-control" id="content" name="content" rows="8" required></textarea>
      </div>
      <div class="mb-3">
        <label for="featured_image" class="form-label">Featured Image</label>
        <input type="file" class="form-control" id="featured_image" name="featured_image" accept="image/*">
      </div>
      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <input type="text" class="form-control" id="category" name="category">
      </div>
      <div class="mb-3">
        <label class="form-label">Publish Options</label>
        <div class="publish-options">
          <label class="me-3"><input type="radio" name="publish_type" value="now" checked> Publish Now</label>
          <label class="me-3"><input type="radio" name="publish_type" value="draft"> Save as Draft</label>
          <label><input type="radio" name="publish_type" value="schedule"> Schedule for Later</label>
        </div>
      </div>
      <div class="mb-3 schedule-datetime" id="scheduleDateTime" style="display: none;">
        <label for="publishDate">Publish Date & Time:</label>
        <input type="datetime-local" id="publishDate" name="published_at" min="">
        <small class="timezone-info">All times are in your local timezone</small>
      </div>
      <input type="hidden" id="status" name="status" value="draft">
      <div id="news-form-message" class="mb-3"></div>
      <button type="submit" class="btn btn-success">Create News</button>
      <a href="/admin/news" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.tiny.cloud/1/r164jjjdorxw1wtb0gzyp6yihah9lic2rqvk4zfks4pyjzkk/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
  <script>
    tinymce.init({
      selector: '#content, #summary',
      plugins: 'link image media lists',
      toolbar: 'undo redo | styles | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media',
      menubar: false,
      height: 350,
      branding: false,
      content_style: "body { font-size: 1.1rem; line-height: 1.7; }"
    });
    // Scheduling logic
    document.addEventListener('DOMContentLoaded', function() {
      const publishTypeRadios = document.querySelectorAll('input[name="publish_type"]');
      const scheduleDateTime = document.getElementById('scheduleDateTime');
      const publishDateInput = document.getElementById('publishDate');
      const statusInput = document.getElementById('status');
      const form = document.querySelector('form');
      // Set min date to now
      if (publishDateInput) {
        const now = new Date();
        publishDateInput.min = now.toISOString().slice(0,16);
      }
      function updateForm() {
        const selected = document.querySelector('input[name="publish_type"]:checked').value;
        if (selected === 'schedule') {
          scheduleDateTime.style.display = '';
          statusInput.value = 'draft';
        } else {
          scheduleDateTime.style.display = 'none';
          publishDateInput.value = '';
          statusInput.value = (selected === 'now') ? 'published' : 'draft';
        }
      }
      publishTypeRadios.forEach(r => r.addEventListener('change', updateForm));
      updateForm();
      form.addEventListener('submit', function(e) {
        if (window.tinymce) {
          tinymce.triggerSave();
        }
        // Custom validation for required fields
        let valid = true;
        const requiredFields = ['title', 'summary', 'content'];
        requiredFields.forEach(function(name) {
          const el = form.querySelector('[name="' + name + '"]');
          if (el && !el.value.trim()) {
            valid = false;
            el.classList.add('is-invalid');
          } else if (el) {
            el.classList.remove('is-invalid');
          }
        });
        if (!valid) {
          e.preventDefault();
          alert('Please fill in all required fields.');
          return false;
        }
        // Schedule validation
        const selected = document.querySelector('input[name="publish_type"]:checked').value;
        if (selected === 'schedule') {
          if (!publishDateInput.value) {
            e.preventDefault();
            alert('Please select a publish date and time.');
            return false;
          }
          if (new Date(publishDateInput.value) <= new Date()) {
            e.preventDefault();
            alert('Publish date/time must be in the future.');
            return false;
          }
        }
      });
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 