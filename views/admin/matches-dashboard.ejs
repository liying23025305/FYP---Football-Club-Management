<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Matches Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/matches.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container my-5">
    <div id="adminMatchesAlert"></div>
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Match Management</h2>
      <div>
        <a href="/admin/news" class="btn btn-secondary me-2">Manage News</a>
        <a href="/admin/faq" class="btn btn-secondary me-2">Manage FAQ</a>
        <a href="/admin/matches" class="btn btn-secondary me-2">Manage matches</a>
        <a href="/admin/matches-create" class="btn btn-success ms-2"><i class="bi bi-plus-lg"></i> Add Match</a>
      </div>
    </div>
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">Total</h5>
            <p class="display-6" id="match-stat-total">-</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">Win</h5>
            <p class="display-6" id="match-stat-win">-</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">Loss</h5>
            <p class="display-6" id="match-stat-loss">-</p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center">
          <div class="card-body">
            <h5 class="card-title">Draw</h5>
            <p class="display-6" id="match-stat-draw">-</p>
          </div>
        </div>
      </div>
    </div>
    <form class="row mb-3 g-2 align-items-end" id="admin-matches-filter-form" onsubmit="return false;">
      <div class="col-md-3">
        <label for="adminSeasonSelect" class="form-label">Season:</label>
        <select id="adminSeasonSelect" class="form-select"></select>
      </div>
      <div class="col-md-3">
        <label for="adminStatusSelect" class="form-label">Status:</label>
        <select id="adminStatusSelect" class="form-select">
          <option value="">All</option>
          <option value="scheduled">Scheduled</option>
          <option value="live">Live</option>
          <option value="completed">Completed</option>
          <option value="postponed">Postponed</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>
      <div class="col-md-4">
        <label for="adminTeamSearch" class="form-label">Search Team:</label>
        <input type="text" id="adminTeamSearch" class="form-control" placeholder="Search team name">
      </div>
      <div class="col-md-2">
        <button id="adminFilterBtn" class="btn btn-secondary w-100 mt-2">Filter</button>
      </div>
    </form>
    <div id="adminMatchesMsg"></div>
    <div class="table-responsive">
      <table class="table table-hover align-middle" id="admin-matches-table">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Home</th>
            <th>Away</th>
            <th>Score</th>
            <th>Result</th>
            <th>Competition</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="adminMatchesTableBody">
          <!-- Rows rendered by JS -->
        </tbody>
      </table>
    </div>
  </div>
  <%- include('../partials/footer') %>
  <script src="/js/admin-matches.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 