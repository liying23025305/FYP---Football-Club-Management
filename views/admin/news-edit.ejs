<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit News Article</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/news.css" />
</head>
<body>
  <div class="container mt-5">
    <h2>Edit News Article</h2>
    <form action="/admin/news/<%= article.news_id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="mt-4">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" id="title" name="title" maxlength="200" value="<%= article.title %>" required>
      </div>
      <div class="mb-3">
        <label for="summary" class="form-label">Summary</label>
        <textarea class="form-control" id="summary" name="summary" maxlength="500" rows="2" required><%= article.summary %></textarea>
      </div>
      <div class="mb-3">
        <label for="content" class="form-label">Content</label>
        <textarea class="form-control" id="content" name="content" rows="8" required><%= article.content %></textarea>
      </div>
      <div class="mb-3">
        <label for="featured_image" class="form-label">Featured Image</label>
        <% if (article.featured_image) { %>
          <div class="mb-2"><img src="<%= article.featured_image %>" alt="Current Image" style="max-width: 200px;"></div>
        <% } %>
        <input type="file" class="form-control" id="featured_image" name="featured_image" accept="image/*">
      </div>
      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <input type="text" class="form-control" id="category" name="category" value="<%= article.category %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Publish Options</label>
        <div class="publish-options">
          <label class="me-3"><input type="radio" name="publish_type" value="now" <%= article.status === 'published' ? 'checked' : '' %>> Publish Now</label>
          <label class="me-3"><input type="radio" name="publish_type" value="draft" <%= article.status === 'draft' && (!article.published_at || new Date(article.published_at) <= new Date()) ? 'checked' : '' %>> Save as Draft</label>
          <label><input type="radio" name="publish_type" value="schedule" <%= article.status === 'draft' && article.published_at && new Date(article.published_at) > new Date() ? 'checked' : '' %>> Schedule for Later</label>
        </div>
      </div>
      <div class="mb-3 schedule-datetime" id="scheduleDateTime" style="display: none;">
        <label for="publishDate">Publish Date & Time:</label>
        <input type="datetime-local" id="publishDate" name="published_at" min="" value="<%= article.published_at ? article.published_at.toISOString().slice(0,16) : '' %>">
        <small class="timezone-info">All times are in your local timezone</small>
      </div>
      <input type="hidden" id="status" name="status" value="<%= article.status %>">
      <div id="news-form-message" class="mb-3"></div>
      <button type="submit" class="btn btn-primary">Update News</button>
      <a href="/admin/news" class="btn btn-secondary ms-2">Cancel</a>
    </form>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.tiny.cloud/1/r164jjjdorxw1wtb0gzyp6yihah9lic2rqvk4zfks4pyjzkk/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
  <script>
    tinymce.init({
      selector: '#content',
      plugins: 'link image media lists',
      toolbar: 'undo redo | styles | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media',
      menubar: false,
      height: 350,
      branding: false,
      content_style: "body { font-size: 1.1rem; line-height: 1.7; }"
    });
    // Scheduling logic
    document.addEventListener('DOMContentLoaded', function() {
      const publishTypeRadios = document.querySelectorAll('input[name="publish_type"]');
      const scheduleDateTime = document.getElementById('scheduleDateTime');
      const publishDateInput = document.getElementById('publishDate');
      const statusInput = document.getElementById('status');
      const form = document.querySelector('form');
      // Set min date to now
      if (publishDateInput) {
        const now = new Date();
        publishDateInput.min = now.toISOString().slice(0,16);
      }
      function updateForm() {
        const selected = document.querySelector('input[name="publish_type"]:checked').value;
        if (selected === 'schedule') {
          scheduleDateTime.style.display = '';
          statusInput.value = 'draft';
        } else {
          scheduleDateTime.style.display = 'none';
          publishDateInput.value = '';
          statusInput.value = (selected === 'now') ? 'published' : 'draft';
        }
      }
      publishTypeRadios.forEach(r => r.addEventListener('change', updateForm));
      updateForm();
      form.addEventListener('submit', function(e) {
        const selected = document.querySelector('input[name="publish_type"]:checked').value;
        if (selected === 'schedule') {
          if (!publishDateInput.value) {
            e.preventDefault();
            alert('Please select a publish date and time.');
            return false;
          }
          if (new Date(publishDateInput.value) <= new Date()) {
            e.preventDefault();
            alert('Publish date/time must be in the future.');
            return false;
          }
        }
      });
    });
  </script>
</body>
</html> 