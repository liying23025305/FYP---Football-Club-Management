<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Matches</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
     <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/matches.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <main class="matches-main">
    <div id="liveMatchContainer"></div>
    <div class="matches-filters-row mb-4">
      <form id="matches-search-form" class="row g-2 align-items-end flex-nowrap w-100">
        <div class="col-md-3">
          <label for="seasonSelect" class="form-label">Season:</label>
          <select id="seasonSelect" class="form-select"></select>
        </div>
        <div class="col-md-3">
          <label for="categorySelect" class="form-label">Competition:</label>
          <select id="categorySelect" class="form-select">
            <option value="">All Competitions</option>
          </select>
        </div>
        <div class="col-md-4">
          <label for="matchesSearchInput" class="form-label">Search Team:</label>
          <input type="text" id="matchesSearchInput" class="form-control" placeholder="Search team name">
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <button type="submit" class="btn btn-outline-primary w-100">Search</button>
        </div>
      </form>
    </div>
    <div id="matchesList" class="matches-list">
      <!-- Match cards will be rendered here by JS -->
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/matches.js"></script>
</body>
</html>
