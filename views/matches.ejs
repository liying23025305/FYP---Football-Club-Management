<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Matches</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/stylesheet/matches.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <main class="matches-main">
    <div class="matches-header mb-3">
      <h1>Fixtures & Results</h1>
    </div>
    <form id="matches-search-form" class="row g-2 mb-4 align-items-end">
      <div class="col-md-3">
        <label for="seasonSelect" class="form-label">Season:</label>
        <select id="seasonSelect" class="form-select"></select>
      </div>
      <div class="col-md-3">
        <label for="categorySelect" class="form-label">Competition:</label>
        <select id="categorySelect" class="form-select">
          <option value="">All Competitions</option>
          <!-- Categories will be populated by JS -->
        </select>
      </div>
      <div class="col-md-4">
        <label for="matchesSearchInput" class="form-label">Search Team:</label>
        <input type="text" id="matchesSearchInput" class="form-control" placeholder="Search team name">
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
      </div>
    </form>
    <div id="matchesList" class="matches-list">
      <!-- Match cards will be rendered here by JS -->
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/matches.js"></script>
</body>
</html>
