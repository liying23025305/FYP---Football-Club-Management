<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Bookmarked News</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/news.css" />
  <link rel="stylesheet" href="/stylesheet/bookmark.css" />
</head>
<body>
  <%- include('partials/navbar', { user: user }) %>
  <main class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>My Bookmarks</h2>
      <a href="/news" class="btn btn-outline-secondary">Back to News</a>
    </div>
    <% if (bookmarks && bookmarks.length > 0) { %>
      <div class="row">
        <% bookmarks.forEach(function(bookmark) { %>
          <div class="col-md-4 mb-3">
            <div class="card h-100">
              <% if (bookmark.featured_image) { %>
                <img src="<%= bookmark.featured_image %>" class="card-img-top" alt="<%= bookmark.title %>">
              <% } %>
              <div class="card-body">
                <h5 class="card-title"><a href="/news/<%= bookmark.news_id %>"><%= bookmark.title %></a></h5>
                <p class="card-text"><%= bookmark.summary %></p>
                <div class="text-muted" style="font-size:0.9rem;">
                  <span>By <%= bookmark.author_name %></span><br>
                  <span>Published: <%= new Date(bookmark.published_at).toLocaleDateString() %></span><br>
                  <span>Bookmarked: <%= new Date(bookmark.bookmarked_at).toLocaleDateString() %></span>
                </div>
                <button class="btn btn-sm btn-outline-warning bookmark-btn mt-2" data-id="<%= bookmark.news_id %>" data-bookmarked="true">
                  <i class="bi bi-bookmark-fill"></i> Remove Bookmark
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="col-12 text-center text-muted py-5">
        <i class="bi bi-bookmark" style="font-size:3em;"></i>
        <div class="mt-3">You haven't bookmarked any news articles yet.</div>
        <a href="/news" class="btn btn-primary mt-3">Browse News</a>
      </div>
    <% } %>
  </main>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/news-bookmark.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <div id="bookmark-toast"></div>
</body>
</html> 