<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Bookmarked News</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/news.css" />
  <link rel="stylesheet" href="/stylesheet/bookmark.css" />
</head>
<body>
  <%- include('partials/navbar', { user: user }) %>
  <main class="container mt-4">
    <div class="d-flex align-items-center mb-3">
      <h2 class="flex-grow-1">Bookmarked News</h2>
      <a href="/news" class="btn btn-outline-secondary ms-auto">Back to News</a>
    </div>
    <div id="bookmarked-news-list" class="row">
      <% if (bookmarks && bookmarks.length > 0) { %>
        <% bookmarks.forEach(function(article) { %>
          <div class="col-md-3 mb-3">
            <div class="card h-100 position-relative">
              <a href="/news/<%= article.news_id %>" style="text-decoration: none; color: inherit;">
                <div style="background:#eee; height:120px; border-radius:8px 8px 0 0; overflow:hidden;">
                  <img src="<%= article.featured_image %>" alt="Image" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <div class="card-body">
                  <h6 class="card-title"><%= article.title %></h6>
                  <div class="text-muted" style="font-size:0.9rem;">
                    <%= article.category %> • <%= article.author_name %> • <%= article.published_at ? new Date(article.published_at).toLocaleString() : '' %>
                  </div>
                </div>
              </a>
              <button class="bookmark-btn" data-news-id="<%= article.news_id %>" aria-label="Remove Bookmark" title="Remove Bookmark" style="position:absolute;top:10px;right:10px;background:none;border:none;">
                <i class="bi bi-bookmark-fill bookmark-icon bookmarked"></i>
              </button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center text-muted py-5">
          <h4>No bookmarked articles yet.</h4>
        </div>
      <% } %>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/news-bookmark.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <div id="bookmark-toast"></div>
</body>
</html>
