<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> - News Detail</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/news.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    .news-detail-img {
      width: 100%;
      height: auto;
      max-height: 400px;
      object-fit: cover;
      border-radius: 1rem 1rem 0 0;
      background: #f8f9fa;
    }
    .news-detail-content iframe {
      width: 100% !important;
      aspect-ratio: 16/9;
      min-height: 300px;
      max-width: 100%;
      border-radius: 0.75rem;
      margin: 1.5rem 0;
      display: block;
    }
    .news-detail-content p {
      margin-bottom: 1.25rem;
      line-height: 1.7;
      font-size: 1.1rem;
    }
  </style>
</head>
<body class="bg-light min-vh-100 d-flex flex-column">
  <%- include('partials/navbar', { user: user }) %>
  <main class="container flex-grow-1 py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">
        <div class="card shadow-lg rounded-4 overflow-hidden mb-4">
          <!-- News Image -->
          <div class="bg-light">
            <img src="<%= article.featured_image %>" alt="News Image" class="news-detail-img">
          </div>
          <!-- News Content -->
          <div class="card-body p-4 p-md-5">
            <h1 class="card-title display-5 fw-bold mb-3"><%= article.title %></h1>
            <div class="mb-3 text-secondary small">
              <span class="me-2"><i class="bi bi-tag"></i> <%= article.category %></span>
              <span class="me-2"><i class="bi bi-person"></i> <%= article.author_name %></span>
              <span><i class="bi bi-calendar-event"></i> <%= article.published_at ? new Date(article.published_at).toLocaleString() : '' %></span>
            </div>
            <div class="news-detail-content mt-4">
              <%- article.sanitizedContent %>
            </div>
          </div>
        </div>
        <div class="text-center my-4">
          <a href="/news" class="btn btn-outline-secondary px-4 py-2"><i class="bi bi-arrow-left"></i> Back to News</a>
        </div>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 