<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Club News</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheet/style.css" />
  <link rel="stylesheet" href="/stylesheet/news.css" />
  <% if (user) { %>
    <link rel="stylesheet" href="/stylesheet/bookmark.css" />
  <% } %>
</head>
<body>
  <!-- Navbar -->
  <%- include('partials/navbar', { user: user }) %>
  <main class="container mt-4 position-relative">
    <div class="d-flex align-items-center mb-3" style="gap: 12px;">
      <form id="news-search-form" class="row flex-grow-1" method="get" action="/news" style="margin-bottom: 0;">
        <div class="col-md-3 mb-2">
          <select class="form-select" name="category" id="news-category-filter">
            <option value="All" <%= selectedCategory === 'All' ? 'selected' : '' %>>All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-5 mb-2">
          <input type="text" class="form-control" name="search" id="news-search-input" placeholder="Search news..." value="<%= search %>">
        </div>
        <div class="col-md-2 mb-2 d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-primary w-100 me-2" id="news-search-btn">Search</button>
        </div>
      </form>
      <% if (user) { %>
        <a href="/news/bookmarked-news" class="btn btn-warning ms-auto d-flex align-items-center" id="bookmarked-news-btn" style="height:40px;">
          <i class="bi bi-bookmark-fill me-1"></i> Bookmarked News
        </a>
      <% } %>
    </div>

    <!-- Featured News Card -->  <!-- TODO: Ensure Featured News is the latest published article-->
    <div id="featured-news-container">
    <% if (featured) { %>
    <a href="/news/<%= featured.news_id %>" style="text-decoration: none; color: inherit;">
      <div class="row mb-4">
        <div class="col-md-7">
          <div style="background:#eee; border-radius:12px; min-height:260px; width:100%; display:flex; align-items:center; justify-content:center; overflow:hidden;">
            <img src="<%= featured.featured_image %>" alt="Image" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
        </div>
        <div class="col-md-5 d-flex align-items-center">
          <div class="card w-100 p-3" style="min-height: 260px;">
            <h5 class="fw-bold"><%= featured.title %></h5>
            <p class="mb-2"><%= featured.summary ? featured.summary.substring(0, 500) : '' %></p>
            <div class="text-muted" style="font-size:0.95rem;">
              <%= featured.category %> • <%= featured.author_name %> • <%= featured.published_at ? new Date(featured.published_at).toLocaleString() : '' %>
            </div>
          </div>
        </div>
      </div>
    </a>
    <% } %>
    </div>

    <!-- News Cards Row -->
    <div class="row" id="news-list">
      <% articles.forEach(function(article) { %>
        <div class="col-md-3 mb-3">
          <div class="card h-100 position-relative">
            <a href="/news/<%= article.news_id %>" style="text-decoration: none; color: inherit;">
              <div style="background:#eee; height:120px; border-radius:8px 8px 0 0; overflow:hidden;">
                <img src="<%= article.featured_image %>" alt="Image" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
              <div class="card-body">
                <h6 class="card-title"><%= article.title %></h6>
                <div class="text-muted" style="font-size:0.9rem;">
                  <%= article.category %> • <%= article.author_name %> • <%= article.published_at ? new Date(article.published_at).toLocaleString() : '' %>
                </div>
              </div>
            </a>
            <% if (user) { %>
              <button class="bookmark-btn" data-news-id="<%= article.news_id %>" aria-label="Bookmark" title="Bookmark" onclick="toggleBookmark(this)" style="position:absolute;top:10px;right:10px;background:none;border:none;">
                <% if (bookmarks && bookmarks.includes(article.news_id)) { %>
                  <i class="bi bi-bookmark-fill bookmark-icon bookmarked"></i>
                <% } else { %>
                  <i class="bi bi-bookmark bookmark-icon"></i>
                <% } %>
              </button>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/news.js"></script>
  <script src="/js/news-bookmark.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <div id="bookmark-toast"></div>
</body>
</html>
